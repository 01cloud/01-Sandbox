# ==============================================================================
# Multi-Cluster Environment Configuration Template
#
# Copy this file to cluster-ips.env, edit your VM IPs, and run:
#   ./docs/multi-cluster-sync.sh --env-file cluster-ips.env
# ==============================================================================

# Physical Underlay VM IPs (Required for your new set of VMs)
GATEWAY_IP="192.168.100.10"
HUB1_IP="192.168.100.20"
HUB2_IP="192.168.101.20"
SPOKE1_IP="192.168.102.20"
SPOKE2_IP="192.168.103.20"

# SSH Credentials
SSH_USER="ubuntu"
# SSH_KEY="/path/to/id_rsa"  # Optional, uncomment if using private key file

# WireGuard Encrypted Overlay Subnet (Optional - change if 10.99.0.0/24 conflicts)
WG_SUBNET_PREFIX="10.99.0"
WG_GATEWAY_IP="10.99.0.254"
WG_VIP="10.99.0.100"
WG_HUB1_IP="10.99.0.1"
WG_HUB2_IP="10.99.0.2"
WG_SPOKE1_IP="10.99.0.3"
WG_SPOKE2_IP="10.99.0.4"
