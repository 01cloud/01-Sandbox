# ==============================================================================
# 01-Sandbox Multi-Cluster Deployment Environment Configuration
# Copy this file to cluster.env and adjust the IP addresses for your VMs.
# Run: ./multi-cluster-sync.sh (it will auto-detect cluster.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Physical / Underlay VM IP Addresses (SSH Access)
# ------------------------------------------------------------------------------
GATEWAY_IP="192.168.100.10"   # Host: gateway-vm
HUB1_IP="192.168.100.20"      # Host: hub1-vm    (Cluster: primaryhub)
HUB2_IP="192.168.101.20"      # Host: hub2-vm    (Cluster: secondaryhub)
SPOKE1_IP="192.168.102.20"    # Host: spoke1-vm  (Cluster: spoke1)
SPOKE2_IP="192.168.103.20"    # Host: spoke2-vm  (Cluster: spoke2)

# SSH Access Credentials
SSH_USER="ubuntu"
SSH_KEY="${HOME}/.ssh/kamal-kvm"

# ------------------------------------------------------------------------------
# 2. WireGuard Overlay Network (Per-Cluster WireGuard IPs)
# ------------------------------------------------------------------------------
WG_SUBNET_PREFIX="10.99.0"

# Cluster: primaryhub (hub1-vm) WireGuard IP - Active Master endpoint
WG_HUB1_IP="10.99.0.1"

# Cluster: secondaryhub (hub2-vm) WireGuard IP - Standby Replica endpoint
WG_HUB2_IP="10.99.0.2"

# Cluster: spoke1 (spoke1-vm) WireGuard IP - Worker execution cluster
WG_SPOKE1_IP="10.99.0.3"

# Cluster: spoke2 (spoke2-vm) WireGuard IP - Worker execution cluster
WG_SPOKE2_IP="10.99.0.4"

# Envoy Gateway Multi-Cluster Virtual WireGuard IP (Traffic VIP)
WG_VIP="10.99.0.100"

# Gateway Host (gateway-vm) WireGuard Interface IP
WG_GATEWAY_IP="10.99.0.254"
