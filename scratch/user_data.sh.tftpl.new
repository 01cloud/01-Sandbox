#!/bin/bash
set -euo pipefail

exec > >(tee -a /var/log/user-data.log | logger -t user-data -s 2>/dev/console) 2>&1
echo "=== Starting Persistent Storage & Autonomous Instance Bootstrap at $(date) ==="

TOKEN=$(curl -sS -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
INSTANCE_ID=$(curl -sS -H "X-aws-ec2-metadata-token: $TOKEN" "http://169.254.169.254/latest/meta-data/instance-id")
AZ=$(curl -sS -H "X-aws-ec2-metadata-token: $TOKEN" "http://169.254.169.254/latest/meta-data/placement/availability-zone")
LOCAL_PRIVATE_IP=$(curl -sS -H "X-aws-ec2-metadata-token: $TOKEN" "http://169.254.169.254/latest/meta-data/local-ipv4" || true)
REGION="${region}"
VOLUME_ID="${volume_id}"
DEVICE="${device_name}"
MOUNT_POINT="${mount_point}"
CLUSTER_NAME="${cluster_name}"
ROLE="${role}"
HUB_PRIORITY="${hub_priority}"
WG_IP="${wg_ip}"

[ -z "$ROLE" ] && { [[ "$CLUSTER_NAME" =~ hub ]] && ROLE="hub" || ROLE="spoke"; }
[ -z "$HUB_PRIORITY" ] && HUB_PRIORITY="0"

echo "Instance ID: $INSTANCE_ID | Cluster: $CLUSTER_NAME | Role: $ROLE ($HUB_PRIORITY) | WG: $WG_IP | Private IP: $LOCAL_PRIVATE_IP"

# Self-publish node metadata to central SSM registry in us-east-1
REG_PAYLOAD=$(jq -nc \
  --arg cn "$CLUSTER_NAME" --arg r "$ROLE" --arg reg "$REGION" \
  --arg wg "$WG_IP" --arg p "$HUB_PRIORITY" --arg vol "$VOLUME_ID" \
  --arg ip "$LOCAL_PRIVATE_IP" \
  "{cluster_name: \$cn, role: \$r, region: \$reg, wg_ip: \$wg, priority: \$p, ebs_volume: \$vol, private_ip: \$ip}")
aws ssm put-parameter --name "/sandbox/clusters/$CLUSTER_NAME" --value "$REG_PAYLOAD" --type "String" --overwrite --region "us-east-1" 2>/dev/null || true

# -----------------------------------------------------------------------------
# 1. Volume Detach & Re-attachment (Spot rebalance handling)
# -----------------------------------------------------------------------------
for attempt in $(seq 1 30); do
  ATTACHED_INSTANCE=$(aws ec2 describe-volumes --volume-ids "$VOLUME_ID" --region "$REGION" --query "Volumes[0].Attachments[0].InstanceId" --output text || true)
  VOLUME_STATE=$(aws ec2 describe-volumes --volume-ids "$VOLUME_ID" --region "$REGION" --query "Volumes[0].State" --output text 2>/dev/null || true)
  if [ "$VOLUME_STATE" = "available" ] || [ "$ATTACHED_INSTANCE" = "$INSTANCE_ID" ]; then break; fi
  if [ -n "$ATTACHED_INSTANCE" ] && [ "$ATTACHED_INSTANCE" != "None" ]; then
    aws ec2 detach-volume --volume-id "$VOLUME_ID" --force --region "$REGION" || true
    sleep 5
  else sleep 3; fi
done

CURRENT_ATTACHMENT=$(aws ec2 describe-volumes --volume-ids "$VOLUME_ID" --region "$REGION" --query "Volumes[0].Attachments[0].InstanceId" --output text || true)
if [ "$CURRENT_ATTACHMENT" != "$INSTANCE_ID" ]; then
  aws ec2 attach-volume --volume-id "$VOLUME_ID" --instance-id "$INSTANCE_ID" --device "$DEVICE" --region "$REGION"
  aws ec2 wait volume-in-use --volume-ids "$VOLUME_ID" --region "$REGION"
fi

VOL_SERIAL=$(echo "$VOLUME_ID" | tr -d "-")
TARGET_DEV=""
for attempt in $(seq 1 30); do
  if [ -b "$DEVICE" ]; then TARGET_DEV="$DEVICE"; break; fi
  for dev in /dev/nvme*n1; do
    if [ -b "$dev" ] && udevadm info --query=property --name="$dev" 2>/dev/null | grep -q "$VOL_SERIAL"; then
      TARGET_DEV="$dev"; break 2
    fi
  done
  NON_ROOT_DISKS=$(lsblk -d -n -o NAME,TYPE | awk '$2=="disk" && $1!~/nvme0n1/ && $1!~/xvda/ {print "/dev/"$1}')
  if [ -n "$NON_ROOT_DISKS" ]; then TARGET_DEV=$(echo "$NON_ROOT_DISKS" | head -n 1); break; fi
  sleep 2
done

if [ -z "$TARGET_DEV" ] || [ ! -b "$TARGET_DEV" ]; then
  echo "FATAL: Block device for $VOLUME_ID not found"; exit 1
fi

if ! blkid "$TARGET_DEV" >/dev/null 2>&1; then
  echo "Formatting new storage volume as XFS..."; mkfs -t xfs "$TARGET_DEV"
fi

mkdir -p "$MOUNT_POINT"
UUID=$(blkid -s UUID -o value "$TARGET_DEV")
grep -q "$UUID" /etc/fstab || echo "UUID=$UUID $MOUNT_POINT xfs defaults,nofail 0 2" >> /etc/fstab
mountpoint -q "$MOUNT_POINT" || mount -a

# -----------------------------------------------------------------------------
# 2. Kernel Limits, Toolchain & Docker Runtime Persistence
# -----------------------------------------------------------------------------
cat <<"EOF_SYS" > /etc/sysctl.d/99-kind.conf
fs.inotify.max_user_watches = 524288
fs.inotify.max_user_instances = 8192
net.ipv4.ip_forward = 1
net.ipv6.conf.all.forwarding = 1
EOF_SYS
sysctl --system >/dev/null 2>&1 || true

dnf install -y docker wireguard-tools iptables iproute jq || true
[ -e /dev/kvm ] && chmod 666 /dev/kvm 2>/dev/null || true

mkdir -p "$MOUNT_POINT/docker" /etc/docker
cat <<EOF_DKR > /etc/docker/daemon.json
{
  "data-root": "$MOUNT_POINT/docker",
  "storage-driver": "overlay2",
  "log-driver": "json-file",
  "log-opts": {"max-size": "100m", "max-file": "3"}
}
EOF_DKR

systemctl enable --now docker
usermod -aG docker ec2-user 2>/dev/null || true
id -u ssm-user >/dev/null 2>&1 && usermod -aG docker ssm-user 2>/dev/null || true
chmod 666 /var/run/docker.sock 2>/dev/null || true

# -----------------------------------------------------------------------------
# 3. WireGuard Overlay Configuration & Keypair Sync
# -----------------------------------------------------------------------------
mkdir -p "$MOUNT_POINT/wireguard"
if [ ! -L /etc/wireguard ]; then
  [ -d /etc/wireguard ] && cp -rn /etc/wireguard/* "$MOUNT_POINT/wireguard/" 2>/dev/null || true
  rm -rf /etc/wireguard
  ln -sf "$MOUNT_POINT/wireguard" /etc/wireguard
fi

if [ ! -f /etc/wireguard/wg0.conf ] || ! grep -q "\[Interface\]" /etc/wireguard/wg0.conf; then
  if [ ! -f /etc/wireguard/private.key ]; then
    wg genkey | tee /etc/wireguard/private.key | wg pubkey > /etc/wireguard/public.key
    chmod 600 /etc/wireguard/private.key /etc/wireguard/public.key
  fi
  MY_PRIVKEY=$(cat /etc/wireguard/private.key)
  cat > /etc/wireguard/wg0.conf <<EOF_WG
[Interface]
Address = $${WG_IP}/24
ListenPort = 51820
PrivateKey = $${MY_PRIVKEY}
PostUp = iptables -A FORWARD -i wg0 -j ACCEPT; iptables -A FORWARD -o wg0 -j ACCEPT; iptables -t nat -A POSTROUTING -o wg0 -j MASQUERADE
PostDown = iptables -D FORWARD -i wg0 -j ACCEPT; iptables -D FORWARD -o wg0 -j ACCEPT; iptables -t nat -D POSTROUTING -o wg0 -j MASQUERADE
EOF_WG
  chmod 600 /etc/wireguard/wg0.conf
fi

iptables -A FORWARD -i wg0 -j ACCEPT 2>/dev/null || true
iptables -A FORWARD -o wg0 -j ACCEPT 2>/dev/null || true
iptables -t nat -A POSTROUTING -o wg0 -j MASQUERADE 2>/dev/null || true

# Prometheus Remote Write Ingress NAT (Hubs): route WireGuard :30900 directly to KinD NodePort
if [ "$ROLE" = "hub" ]; then
  iptables -t nat -C PREROUTING ! -i br-+ -p tcp --dport 30900 -j DNAT --to-destination 172.18.0.2:30900 2>/dev/null || \
  iptables -t nat -A PREROUTING ! -i br-+ -p tcp --dport 30900 -j DNAT --to-destination 172.18.0.2:30900 2>/dev/null || true
  iptables -t nat -C OUTPUT -p tcp -o lo --dport 30900 -j DNAT --to-destination 172.18.0.2:30900 2>/dev/null || \
  iptables -t nat -A OUTPUT -p tcp -o lo --dport 30900 -j DNAT --to-destination 172.18.0.2:30900 2>/dev/null || true
fi

# Spokes: Ensure no blanket DNAT rule on 30900 intercepts outbound Remote Write traffic
if [ "$ROLE" = "spoke" ]; then
  iptables -t nat -D PREROUTING -p tcp -m tcp --dport 30900 -j DNAT --to-destination 172.18.0.2:30900 2>/dev/null || true
  iptables -t nat -D OUTPUT -p tcp -m tcp --dport 30900 -j DNAT --to-destination 172.18.0.2:30900 2>/dev/null || true
fi

MY_PUBKEY=$(cat /etc/wireguard/public.key 2>/dev/null || wg show wg0 public-key 2>/dev/null || awk "/PrivateKey/ {print \$3}" /etc/wireguard/wg0.conf | wg pubkey 2>/dev/null || true)
if [ -n "$MY_PUBKEY" ]; then
  aws ssm put-parameter --name "/sandbox/wireguard/$CLUSTER_NAME/public-key" --value "$MY_PUBKEY" --type "String" --overwrite --region "us-east-1" 2>/dev/null || true
fi

cat << "EOF_SYNC" > /usr/local/bin/sync-wireguard-peers.sh
#!/usr/bin/env bash
set -euo pipefail
CONF="/etc/wireguard/wg0.conf"
[ -f "$CONF" ] && grep -q "\[Interface\]" "$CONF" || exit 0
SELF_NAME="${cluster_name}"
SELF_REGION="${region}"

iptables -C FORWARD -i wg0 -j ACCEPT 2>/dev/null || iptables -A FORWARD -i wg0 -j ACCEPT 2>/dev/null || true
iptables -C FORWARD -o wg0 -j ACCEPT 2>/dev/null || iptables -A FORWARD -o wg0 -j ACCEPT 2>/dev/null || true
iptables -t nat -C POSTROUTING -o wg0 -j MASQUERADE 2>/dev/null || iptables -t nat -A POSTROUTING -o wg0 -j MASQUERADE 2>/dev/null || true

if [ "$${ROLE:-}" = "hub" ]; then
  iptables -t nat -C PREROUTING ! -i br-+ -p tcp --dport 30900 -j DNAT --to-destination 172.18.0.2:30900 2>/dev/null || \
  iptables -t nat -A PREROUTING ! -i br-+ -p tcp --dport 30900 -j DNAT --to-destination 172.18.0.2:30900 2>/dev/null || true
fi

cluster_params=$(aws ssm get-parameters-by-path --path "/sandbox/clusters" --region "us-east-1" --query "Parameters[*].Value" --output json 2>/dev/null || echo "[]")
[ -z "$cluster_params" ] || [ "$cluster_params" == "[]" ] && exit 0

TMP_CONF="/etc/wireguard/wg0.conf.tmp.$$"
awk '/^\[Interface\]/{flag=1} /^\[Peer\]/{flag=0} flag {print}' "$CONF" > "$TMP_CONF"

while IFS= read -r entry; do
  [ -z "$entry" ] && continue
  peer_cluster=$(echo "$entry" | jq -r ".cluster_name // empty" 2>/dev/null || true)
  peer_region=$(echo "$entry" | jq -r ".region // empty" 2>/dev/null || true)
  peer_wg_ip=$(echo "$entry" | jq -r ".wg_ip // empty" 2>/dev/null || true)
  peer_priv_ip=$(echo "$entry" | jq -r ".private_ip // empty" 2>/dev/null || true)
  [ -z "$peer_cluster" ] || [ "$peer_cluster" == "$SELF_NAME" ] && continue

  peer_pubkey=$(aws ssm get-parameter --name "/sandbox/wireguard/$${peer_cluster}/public-key" --region "us-east-1" --query "Parameter.Value" --output text 2>/dev/null || true)
  [ -z "$peer_pubkey" ] || [ "$peer_pubkey" = "None" ] && continue
  [[ "$peer_pubkey" =~ ^[A-Za-z0-9+/=]{44}$ ]] || continue
  [[ "$peer_wg_ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || continue

  if [[ "$peer_priv_ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    current_ip="$peer_priv_ip"
  else
    current_ip=$(aws ec2 describe-instances --region "$peer_region" --filters "Name=tag:ClusterName,Values=$${peer_cluster}" "Name=instance-state-name,Values=running" --query "Reservations[0].Instances[0].PrivateIpAddress" --output text 2>/dev/null || true)
  fi

  if [[ "$current_ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    cat >> "$TMP_CONF" <<EOF_PEER

[Peer]
# $${peer_cluster}
PublicKey = $${peer_pubkey}
AllowedIPs = $${peer_wg_ip}/32
Endpoint = $${current_ip}:51820
PersistentKeepalive = 25
EOF_PEER
  fi
done < <(echo "$cluster_params" | jq -c ".[] | (if type==\"string\" then fromjson else . end)" 2>/dev/null || true)

if [ -s "$TMP_CONF" ] && grep -q "\[Interface\]" "$TMP_CONF"; then
  chmod 600 "$TMP_CONF"
  mv -f "$TMP_CONF" "$CONF"
  if ip link show wg0 >/dev/null 2>&1; then
    wg syncconf wg0 <(wg-quick strip "$CONF" 2>/dev/null) 2>/dev/null || true
  else
    systemctl enable --now wg-quick@wg0 2>/dev/null || wg-quick up wg0 2>/dev/null || true
  fi
else
  rm -f "$TMP_CONF"
fi
EOF_SYNC
chmod +x /usr/local/bin/sync-wireguard-peers.sh

cat << "EOF_SVC" > /etc/systemd/system/wireguard-peers-sync.service
[Unit]
Description=Dynamic WireGuard Peer Endpoint Sync
After=network-online.target
[Service]
Type=oneshot
ExecStart=/usr/local/bin/sync-wireguard-peers.sh
EOF_SVC

cat << "EOF_TMR" > /etc/systemd/system/wireguard-peers-sync.timer
[Unit]
Description=Run Dynamic WireGuard Peer Sync periodically
[Timer]
OnBootSec=10s
OnUnitActiveSec=20s
[Install]
WantedBy=timers.target
EOF_TMR

systemctl daemon-reload
systemctl enable --now wireguard-peers-sync.timer 2>/dev/null || true
/usr/local/bin/sync-wireguard-peers.sh 2>/dev/null || true

# -----------------------------------------------------------------------------
# 4. Kubernetes Tools Installation
# -----------------------------------------------------------------------------
if ! command -v kind >/dev/null 2>&1; then
  curl -fsSLo /usr/local/bin/kind https://kind.sigs.k8s.io/dl/v0.27.0/kind-linux-amd64 && chmod +x /usr/local/bin/kind || true
fi
if ! command -v kubectl >/dev/null 2>&1; then
  curl -fsSLo /usr/local/bin/kubectl https://dl.k8s.io/release/v1.32.2/bin/linux/amd64/kubectl && chmod +x /usr/local/bin/kubectl || true
fi
if ! command -v clusteradm >/dev/null 2>&1; then
  ARCH=$(uname -m); [ "$ARCH" = "x86_64" ] && ARCH="amd64" || ARCH="arm64"
  curl -fsSL "https://github.com/open-cluster-management-io/clusteradm/releases/download/v0.8.0/clusteradm_linux_$${ARCH}.tar.gz" | tar -xz -C /usr/local/bin clusteradm 2>/dev/null || true
  chmod +x /usr/local/bin/clusteradm 2>/dev/null || true
fi
for tb in kind kubectl clusteradm; do
  [ -x "/usr/local/bin/$tb" ] && [ ! -x "/usr/bin/$tb" ] && ln -sf "/usr/local/bin/$tb" "/usr/bin/$tb" || true
done

setup_kubeconfig() {
  local container="$1"
  mkdir -p /etc/kubernetes /root/.kube /home/ssm-user/.kube /home/ec2-user/.kube
  docker exec "$container" cat /etc/kubernetes/admin.conf > /etc/kubernetes/admin.conf 2>/dev/null || \
    kind export kubeconfig --name "$CLUSTER_NAME" --kubeconfig /etc/kubernetes/admin.conf 2>/dev/null || true
  sed -i "s|https://$${container}:6443|https://127.0.0.1:6443|g" /etc/kubernetes/admin.conf 2>/dev/null || true
  chmod 644 /etc/kubernetes/admin.conf 2>/dev/null || true
  echo "export KUBECONFIG=/etc/kubernetes/admin.conf" > /etc/profile.d/kubeconfig.sh
  chmod 644 /etc/profile.d/kubeconfig.sh
  grep -q "KUBECONFIG" /etc/bashrc 2>/dev/null || echo "export KUBECONFIG=/etc/kubernetes/admin.conf" >> /etc/bashrc
  grep -q "KUBECONFIG" /etc/environment 2>/dev/null || echo "KUBECONFIG=/etc/kubernetes/admin.conf" >> /etc/environment
  for ud in /root /home/ec2-user /home/ssm-user; do
    cp -f /etc/kubernetes/admin.conf "$ud/.kube/config" 2>/dev/null || true
  done
  chown -R ec2-user:ec2-user /home/ec2-user/.kube 2>/dev/null || true
  chown -R ssm-user:ssm-user /home/ssm-user/.kube 2>/dev/null || true
}

# -----------------------------------------------------------------------------
# Autonomous Spoke Prometheus Remote Write Deployment
# -----------------------------------------------------------------------------
deploy_spoke_monitoring() {
  echo "=== Deploying Autonomous Spoke Prometheus Scraper (Push to PrimaryHub) ==="
  export KUBECONFIG=/etc/kubernetes/admin.conf
  kubectl apply -f - <<'EOF_MON_BASE'
apiVersion: v1
kind: Namespace
metadata:
  name: monitoring
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: prometheus-scraper
  namespace: monitoring
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: prometheus-scraper-role
rules:
  - apiGroups: [""]
    resources:
      - nodes
      - nodes/metrics
      - services
      - endpoints
      - pods
    verbs: ["get", "list", "watch"]
  - apiGroups: ["apps"]
    resources:
      - daemonsets
      - statefulsets
      - deployments
    verbs: ["get", "list", "watch"]
  - nonResourceURLs: ["/metrics"]
    verbs: ["get"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: prometheus-scraper-binding
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: prometheus-scraper-role
subjects:
  - kind: ServiceAccount
    name: prometheus-scraper
    namespace: monitoring
EOF_MON_BASE

  cat <<EOF_CM | kubectl apply -f -
apiVersion: v1
kind: ConfigMap
metadata:
  name: prometheus-scraper-config
  namespace: monitoring
data:
  prometheus.yml: |
    global:
      scrape_interval: 15s
      evaluation_interval: 15s
      scrape_timeout: 10s
      external_labels:
        cluster: "${cluster_name}"
        role: "spoke"

    remote_write:
      - url: "http://10.99.0.1:30900/api/v1/write"
        queue_config:
          capacity: 10000
          max_shards: 10
          min_shards: 1
          max_samples_per_send: 1000
          batch_send_deadline: 5s
          min_backoff: 500ms
          max_backoff: 10s

    scrape_configs:
      - job_name: 'prometheus-scraper'
        static_configs:
          - targets: ['localhost:9090']

      - job_name: 'open-cluster-management-agent'
        kubernetes_sd_configs:
          - role: pod
            namespaces:
              names:
                - open-cluster-management-agent
        relabel_configs:
          - source_labels: [__address__]
            action: replace
            regex: ([^:]+)(?::\d+)?
            replacement: \$1:8080
            target_label: __address__
          - action: labelmap
            regex: __meta_kubernetes_pod_label_(.+)
          - source_labels: [__meta_kubernetes_namespace]
            target_label: kubernetes_namespace
          - source_labels: [__meta_kubernetes_pod_name]
            target_label: kubernetes_pod_name

      - job_name: 'kubernetes-services'
        kubernetes_sd_configs:
          - role: service
        relabel_configs:
          - source_labels: [__meta_kubernetes_service_annotation_prometheus_io_scrape]
            action: keep
            regex: true
          - source_labels: [__meta_kubernetes_service_annotation_prometheus_io_path]
            action: replace
            target_label: __metrics_path__
            regex: (.+)
          - source_labels: [__address__, __meta_kubernetes_service_annotation_prometheus_io_port]
            action: replace
            regex: ([^:]+)(?::\d+)?;(\d+)
            replacement: \$1:\$2
            target_label: __address__
          - action: labelmap
            regex: __meta_kubernetes_service_label_(.+)
          - source_labels: [__meta_kubernetes_namespace]
            target_label: kubernetes_namespace
          - source_labels: [__meta_kubernetes_service_name]
            target_label: kubernetes_name

      - job_name: 'kubernetes-pods'
        kubernetes_sd_configs:
          - role: pod
        relabel_configs:
          - source_labels: [__meta_kubernetes_pod_annotation_prometheus_io_scrape]
            action: keep
            regex: true
          - source_labels: [__meta_kubernetes_pod_annotation_prometheus_io_path]
            action: replace
            target_label: __metrics_path__
            regex: (.+)
          - source_labels: [__address__, __meta_kubernetes_pod_annotation_prometheus_io_port]
            action: replace
            regex: ([^:]+)(?::\d+)?;(\d+)
            replacement: \$1:\$2
            target_label: __address__
          - action: labelmap
            regex: __meta_kubernetes_pod_label_(.+)
          - source_labels: [__meta_kubernetes_namespace]
            target_label: kubernetes_namespace
          - source_labels: [__meta_kubernetes_pod_name]
            target_label: kubernetes_pod_name
EOF_CM

  kubectl apply -f - <<'EOF_MON_DEP'
apiVersion: apps/v1
kind: Deployment
metadata:
  name: prometheus-scraper
  namespace: monitoring
  labels:
    app: prometheus-scraper
spec:
  replicas: 1
  selector:
    matchLabels:
      app: prometheus-scraper
  template:
    metadata:
      labels:
        app: prometheus-scraper
    spec:
      serviceAccountName: prometheus-scraper
      containers:
        - name: prometheus
          image: prom/prometheus:v2.54.1
          imagePullPolicy: IfNotPresent
          args:
            - "--config.file=/etc/prometheus/prometheus.yml"
            - "--storage.tsdb.path=/prometheus"
            - "--storage.tsdb.retention.time=6h"
            - "--web.enable-lifecycle"
          ports:
            - containerPort: 9090
              name: metrics
          resources:
            requests:
              cpu: 50m
              memory: 128Mi
            limits:
              cpu: 250m
              memory: 256Mi
          volumeMounts:
            - name: config
              mountPath: /etc/prometheus
            - name: storage
              mountPath: /prometheus
      volumes:
        - name: config
          configMap:
            name: prometheus-scraper-config
        - name: storage
          emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: prometheus-scraper
  namespace: monitoring
  labels:
    app: prometheus-scraper
spec:
  type: ClusterIP
  selector:
    app: prometheus-scraper
  ports:
    - name: metrics
      port: 9090
      targetPort: 9090
      protocol: TCP
---
apiVersion: v1
kind: Service
metadata:
  name: prometheus-scraper-nodeport
  namespace: monitoring
  labels:
    app: prometheus-scraper
spec:
  type: NodePort
  selector:
    app: prometheus-scraper
  ports:
    - name: metrics
      port: 9090
      targetPort: 9090
      nodePort: 30900
      protocol: TCP
EOF_MON_DEP
  echo "=== Autonomous Spoke Prometheus Scraper Deployed Successfully ==="
}


# -----------------------------------------------------------------------------
# 5. Autonomous KinD & OCM Cluster Lifecycle
# -----------------------------------------------------------------------------
CLUSTER_CONTAINER="${cluster_name}-control-plane"
grep -q "$CLUSTER_CONTAINER" /etc/hosts || echo "127.0.0.1 $CLUSTER_CONTAINER" >> /etc/hosts

if ! docker ps -a --format "{{.Names}}" | grep -q "^$CLUSTER_CONTAINER$"; then
  echo "=== Fresh node detected: Launching Autonomous Zero-Touch Bootstrap ==="
  EXTRA_MOUNTS=""
  if [ "$ROLE" = "hub" ]; then
    if [ "$HUB_PRIORITY" = "1" ]; then
      POD_SUBNET="10.244.0.0/16"; SVC_SUBNET="10.96.0.0/16"
    else
      POD_SUBNET="10.$((243 + HUB_PRIORITY)).0.0/16"; SVC_SUBNET="10.$((95 + HUB_PRIORITY)).0.0/16"
      mkdir -p /tmp/pki "$MOUNT_POINT/pki"
      for attempt in $(seq 1 60); do
        aws ssm get-parameter --name "/sandbox/pki/ca.crt" --region "us-east-1" --query "Parameter.Value" --output text > /tmp/pki/ca.crt 2>/dev/null || true
        [ -s /tmp/pki/ca.crt ] && ! grep -q "None" /tmp/pki/ca.crt && grep -q "BEGIN CERTIFICATE" /tmp/pki/ca.crt && break
        sleep 5
      done
      for kf in ca.key sa.key sa.pub; do
        aws ssm get-parameter --name "/sandbox/pki/$kf" --region "us-east-1" --query "Parameter.Value" --output text > "/tmp/pki/$kf" 2>/dev/null || true
      done
      cp -a /tmp/pki/* "$MOUNT_POINT/pki/" 2>/dev/null || true
      chmod 600 /tmp/pki/*.key 2>/dev/null || true; chmod 644 /tmp/pki/*.crt /tmp/pki/*.pub 2>/dev/null || true
      EXTRA_MOUNTS="  extraMounts:
  - hostPath: /tmp/pki/ca.crt
    containerPath: /etc/kubernetes/pki/ca.crt
  - hostPath: /tmp/pki/ca.key
    containerPath: /etc/kubernetes/pki/ca.key
  - hostPath: /tmp/pki/sa.key
    containerPath: /etc/kubernetes/pki/sa.key
  - hostPath: /tmp/pki/sa.pub
    containerPath: /etc/kubernetes/pki/sa.pub"
    fi
  else
    SPOKE_NUM=$(echo "$CLUSTER_NAME" | grep -o "[0-9]\+" || echo "1")
    POD_SUBNET="10.$((100 + SPOKE_NUM)).0.0/16"; SVC_SUBNET="10.$((200 + SPOKE_NUM)).0.0/16"
    EXTRA_MOUNTS="  extraMounts:
  - hostPath: /dev/net/tun
    containerPath: /dev/net/tun"
    [ -c /dev/kvm ] && EXTRA_MOUNTS="$EXTRA_MOUNTS
  - hostPath: /dev/kvm
    containerPath: /dev/kvm"
  fi

  cat <<EOF_KIND > "/tmp/kind-$CLUSTER_NAME.yaml"
kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
networking:
  podSubnet: "$POD_SUBNET"
  serviceSubnet: "$SVC_SUBNET"
kubeadmConfigPatches:
- |
  apiVersion: kubeadm.k8s.io/v1beta3
  kind: ClusterConfiguration
  apiServer:
    certSANs:
    - "127.0.0.1"
    - "localhost"
    - "$CLUSTER_NAME"
    - "$CLUSTER_CONTAINER"
    - "$WG_IP"
    - "10.99.0.1"
    - "10.99.0.2"
    - "10.99.0.5"
    - "10.99.0.100"
    - "$LOCAL_PRIVATE_IP"
    - "kubernetes"
    - "kubernetes.default"
    - "kubernetes.default.svc"
    - "kubernetes.default.svc.cluster.local"
nodes:
- role: control-plane
  extraPortMappings:
  - containerPort: 6443
    hostPort: 6443
    protocol: TCP
  - containerPort: 30432
    hostPort: 30432
    protocol: TCP
  - containerPort: 30379
    hostPort: 30379
    protocol: TCP
  - containerPort: 30900
    hostPort: 30900
    protocol: TCP
$EXTRA_MOUNTS
EOF_KIND

  kind create cluster --name "$CLUSTER_NAME" --config "/tmp/kind-$CLUSTER_NAME.yaml" --kubeconfig /etc/kubernetes/admin.conf
  docker update --restart=always "$CLUSTER_CONTAINER" 2>/dev/null || true
  setup_kubeconfig "$CLUSTER_CONTAINER"

  for attempt in $(seq 1 45); do
    kubectl --kubeconfig=/etc/kubernetes/admin.conf get nodes >/dev/null 2>&1 && break || sleep 2
  done

  if [ "$ROLE" = "hub" ]; then
    if [ "$HUB_PRIORITY" = "1" ]; then
      mkdir -p "$MOUNT_POINT/pki"
      for kf in ca.crt ca.key sa.key sa.pub; do
        docker cp "$CLUSTER_CONTAINER:/etc/kubernetes/pki/$kf" "$MOUNT_POINT/pki/$kf" 2>/dev/null || true
        [ -s "$MOUNT_POINT/pki/$kf" ] && aws ssm put-parameter --name "/sandbox/pki/$kf" --value "$(cat "$MOUNT_POINT/pki/$kf")" --type "String" --overwrite --region "us-east-1" 2>/dev/null || true
      done
      [ -s "$MOUNT_POINT/pki/ca.crt" ] && aws ssm put-parameter --name "/sandbox/ocm/hubs/primaryhub/ca.crt" --value "$(cat "$MOUNT_POINT/pki/ca.crt")" --type "String" --overwrite --region "us-east-1" 2>/dev/null || true
      clusteradm init --wait 2>&1 || true
      BOOTSTRAP_TOKEN=$(kubectl --kubeconfig=/etc/kubernetes/admin.conf -n open-cluster-management create token cluster-bootstrap --duration=87600h 2>/dev/null || kubectl --kubeconfig=/etc/kubernetes/admin.conf -n open-cluster-management create token agent-registration-bootstrap --duration=87600h 2>/dev/null || clusteradm get token 2>/dev/null | grep -oP "(?<=--hub-token )\S+" | head -1 || true)
      if [ -n "$BOOTSTRAP_TOKEN" ]; then
        aws ssm put-parameter --name "/sandbox/ocm/bootstrap-token" --value "$BOOTSTRAP_TOKEN" --type "String" --overwrite --region "us-east-1" 2>/dev/null || true
        aws ssm put-parameter --name "/sandbox/ocm/hub-apiserver" --value "https://$${WG_IP}:6443" --type "String" --overwrite --region "us-east-1" 2>/dev/null || true
        aws ssm put-parameter --name "/sandbox/ocm/tokens/$CLUSTER_NAME" --value "$BOOTSTRAP_TOKEN" --type "SecureString" --overwrite --region "us-east-1" 2>/dev/null || true
      fi
      kubectl --kubeconfig=/etc/kubernetes/admin.conf patch clustermanager cluster-manager --type=merge -p '{"spec":{"registrationConfiguration":{"featureGates":[{"feature":"ManagedClusterAutoApproval","mode":"Enable"}],"autoApproveUsers":["kubernetes-admin"]}}}' 2>/dev/null || true
    else
      export KUBECONFIG=/etc/kubernetes/admin.conf
      docker cp "$CLUSTER_CONTAINER:/etc/kubernetes/pki/ca.crt" /tmp/ca.crt 2>/dev/null || true
      [ -s /tmp/ca.crt ] && aws ssm put-parameter --name "/sandbox/ocm/hubs/$CLUSTER_NAME/ca.crt" --value "$(cat /tmp/ca.crt)" --type "String" --overwrite --region "us-east-1" 2>/dev/null || true
      clusteradm init --wait 2>&1 || true
      BOOTSTRAP_TOKEN=$(kubectl --kubeconfig=/etc/kubernetes/admin.conf -n open-cluster-management create token cluster-bootstrap --duration=87600h 2>/dev/null || kubectl --kubeconfig=/etc/kubernetes/admin.conf -n open-cluster-management create token agent-registration-bootstrap --duration=87600h 2>/dev/null || clusteradm get token 2>/dev/null | grep -oP "(?<=--hub-token )\S+" | head -1 || true)
      if [ -n "$BOOTSTRAP_TOKEN" ]; then
        aws ssm put-parameter --name "/sandbox/ocm/tokens/$CLUSTER_NAME" --value "$BOOTSTRAP_TOKEN" --type "SecureString" --overwrite --region "us-east-1" 2>/dev/null || true
        aws ssm put-parameter --name "/sandbox/ocm/hubs/$CLUSTER_NAME/apiserver" --value "https://$${WG_IP}:6443" --type "String" --overwrite --region "us-east-1" 2>/dev/null || true
      fi
      kubectl --kubeconfig=/etc/kubernetes/admin.conf patch clustermanager cluster-manager --type=merge -p '{"spec":{"registrationConfiguration":{"featureGates":[{"feature":"ManagedClusterAutoApproval","mode":"Enable"}],"autoApproveUsers":["kubernetes-admin"]}}}' 2>/dev/null || true
      aws ssm put-parameter --name "/sandbox/ocm/$${CLUSTER_NAME}-ready" --value "true" --type "String" --overwrite --region "us-east-1" 2>/dev/null || true
    fi
  else
    kubectl --kubeconfig=/etc/kubernetes/admin.conf taint nodes --all node-role.kubernetes.io/control-plane:NoSchedule- 2>/dev/null || true
    export KUBECONFIG=/etc/kubernetes/admin.conf
    HUB_TOKEN=""; HUB_URL=""
    for attempt in $(seq 1 60); do
      if curl -sk -m 2 "https://10.99.0.1:6443/livez" >/dev/null 2>&1; then
        HUB_TOKEN=$(aws ssm get-parameter --name "/sandbox/ocm/tokens/primaryhub" --region "us-east-1" --query "Parameter.Value" --with-decryption --output text 2>/dev/null || \
                    aws ssm get-parameter --name "/sandbox/ocm/bootstrap-token" --region "us-east-1" --query "Parameter.Value" --output text 2>/dev/null || true)
        HUB_URL="https://10.99.0.1:6443"
      elif curl -sk -m 2 "https://10.99.0.2:6443/livez" >/dev/null 2>&1; then
        HUB_TOKEN=$(aws ssm get-parameter --name "/sandbox/ocm/tokens/secondaryhub" --region "us-east-1" --query "Parameter.Value" --with-decryption --output text 2>/dev/null || true)
        HUB_URL="https://10.99.0.2:6443"
      fi
      [ -n "$HUB_TOKEN" ] && [ "$HUB_TOKEN" != "None" ] && [ -n "$HUB_URL" ] && [ "$HUB_URL" != "None" ] && break || sleep 5
    done
    if [ -n "$HUB_TOKEN" ] && [ "$HUB_TOKEN" != "None" ] && [ -n "$HUB_URL" ]; then
      clusteradm --kubeconfig=/etc/kubernetes/admin.conf join --hub-token "$HUB_TOKEN" --hub-apiserver "$HUB_URL" --cluster-name "$CLUSTER_NAME" --wait=false 2>&1 || true
    fi
    deploy_spoke_monitoring
  fi
else
  echo "=== Existing container $CLUSTER_CONTAINER found: Resuming Spot State ==="
  if [ "$ROLE" = "hub" ] && [ "$HUB_PRIORITY" != "1" ]; then
    mkdir -p /tmp/pki "$MOUNT_POINT/pki"
    rm -rf /tmp/pki/* 2>/dev/null || true
    for kf in ca.crt ca.key sa.key sa.pub; do
      if [ -s "$MOUNT_POINT/pki/$kf" ]; then
        cp -f "$MOUNT_POINT/pki/$kf" "/tmp/pki/$kf"
      else
        aws ssm get-parameter --name "/sandbox/pki/$kf" --region "us-east-1" --query "Parameter.Value" --output text > "/tmp/pki/$kf" 2>/dev/null || true
        [ -s "/tmp/pki/$kf" ] && cp -f "/tmp/pki/$kf" "$MOUNT_POINT/pki/$kf" 2>/dev/null || true
      fi
    done
    chmod 600 /tmp/pki/*.key 2>/dev/null || true
    chmod 644 /tmp/pki/*.crt /tmp/pki/*.pub 2>/dev/null || true
  fi
  docker update --restart=always "$CLUSTER_CONTAINER" 2>/dev/null || true
  docker start "$CLUSTER_CONTAINER" || true
  for attempt in $(seq 1 45); do
    docker exec "$CLUSTER_CONTAINER" kubectl --kubeconfig=/etc/kubernetes/admin.conf get nodes >/dev/null 2>&1 && break || sleep 2
  done
  setup_kubeconfig "$CLUSTER_CONTAINER"
  if [ "$ROLE" = "spoke" ]; then
    [ -e /dev/kvm ] && chmod 666 /dev/kvm 2>/dev/null || true
    docker exec "$CLUSTER_CONTAINER" kubectl --kubeconfig=/etc/kubernetes/admin.conf -n kube-system rollout restart daemonset/kata-fc-node-reconciler 2>/dev/null || true
    docker exec "$CLUSTER_CONTAINER" kubectl --kubeconfig=/etc/kubernetes/admin.conf -n open-cluster-management-agent rollout restart deployment/klusterlet-registration-agent deployment/klusterlet-work-agent 2>/dev/null || true
    deploy_spoke_monitoring
  elif [ "$ROLE" = "hub" ]; then
    if [ "$HUB_PRIORITY" = "1" ]; then
      docker ps -a --format "{{.Names}}" | grep -q "^envoy-gateway$" && { docker update --restart=always envoy-gateway 2>/dev/null || true; docker start envoy-gateway 2>/dev/null || true; }
      mkdir -p "$MOUNT_POINT/pki"
      for kf in ca.crt ca.key sa.key sa.pub; do
        [ -s "$MOUNT_POINT/pki/$kf" ] || docker cp "$CLUSTER_CONTAINER:/etc/kubernetes/pki/$kf" "$MOUNT_POINT/pki/$kf" 2>/dev/null || true
        [ -s "$MOUNT_POINT/pki/$kf" ] && aws ssm put-parameter --name "/sandbox/pki/$kf" --value "$(cat "$MOUNT_POINT/pki/$kf")" --type "String" --overwrite --region "us-east-1" 2>/dev/null || true
      done
      BOOTSTRAP_TOKEN=$(kubectl --kubeconfig=/etc/kubernetes/admin.conf -n open-cluster-management create token cluster-bootstrap --duration=87600h 2>/dev/null || kubectl --kubeconfig=/etc/kubernetes/admin.conf -n open-cluster-management create token agent-registration-bootstrap --duration=87600h 2>/dev/null || clusteradm get token 2>/dev/null | grep -oP "(?<=--hub-token )\S+" | head -1 || true)
      if [ -n "$BOOTSTRAP_TOKEN" ]; then
        aws ssm put-parameter --name "/sandbox/ocm/bootstrap-token" --value "$BOOTSTRAP_TOKEN" --type "String" --overwrite --region "us-east-1" 2>/dev/null || true
        aws ssm put-parameter --name "/sandbox/ocm/hub-apiserver" --value "https://$${WG_IP}:6443" --type "String" --overwrite --region "us-east-1" 2>/dev/null || true
        aws ssm put-parameter --name "/sandbox/ocm/tokens/$CLUSTER_NAME" --value "$BOOTSTRAP_TOKEN" --type "SecureString" --overwrite --region "us-east-1" 2>/dev/null || true
      fi
    else
      BOOTSTRAP_TOKEN=$(kubectl --kubeconfig=/etc/kubernetes/admin.conf -n open-cluster-management create token cluster-bootstrap --duration=87600h 2>/dev/null || kubectl --kubeconfig=/etc/kubernetes/admin.conf -n open-cluster-management create token agent-registration-bootstrap --duration=87600h 2>/dev/null || clusteradm get token 2>/dev/null | grep -oP "(?<=--hub-token )\S+" | head -1 || true)
      if [ -n "$BOOTSTRAP_TOKEN" ]; then
        aws ssm put-parameter --name "/sandbox/ocm/tokens/$CLUSTER_NAME" --value "$BOOTSTRAP_TOKEN" --type "SecureString" --overwrite --region "us-east-1" 2>/dev/null || true
        aws ssm put-parameter --name "/sandbox/ocm/hubs/$CLUSTER_NAME/apiserver" --value "https://$${WG_IP}:6443" --type "String" --overwrite --region "us-east-1" 2>/dev/null || true
      fi
    fi
    kubectl --kubeconfig=/etc/kubernetes/admin.conf patch clustermanager cluster-manager --type=merge -p '{"spec":{"registrationConfiguration":{"featureGates":[{"feature":"ManagedClusterAutoApproval","mode":"Enable"}],"autoApproveUsers":["kubernetes-admin"]}}}' 2>/dev/null || true
  fi
fi

# -----------------------------------------------------------------------------
# 6. Hub Auto-Acceptor & Active/Standby Controller
# -----------------------------------------------------------------------------
if [ "$ROLE" = "hub" ]; then
  cat << "EOF_ACC" > /usr/local/bin/ocm-auto-accept.sh
#!/usr/bin/env bash
set -euo pipefail
export KUBECONFIG=/etc/kubernetes/admin.conf
[ -f "$KUBECONFIG" ] && command -v clusteradm >/dev/null 2>&1 || exit 0

ROLE="${role}"
HUB_PRIORITY="${hub_priority}"

PRIMARY_ALIVE=false
if curl -sk -m 2 "https://10.99.0.1:6443/livez" >/dev/null 2>&1; then
  PRIMARY_ALIVE=true
fi

IS_ACTIVE_HUB=false
if [ "$HUB_PRIORITY" = "1" ]; then
  IS_ACTIVE_HUB=true
elif [ "$PRIMARY_ALIVE" = false ]; then
  IS_ACTIVE_HUB=true
fi

if [ "$IS_ACTIVE_HUB" = true ]; then
  # 1. Clean up stale approved CSRs older than 1 hour to prevent caching dead certs
  kubectl get csr --no-headers 2>/dev/null | awk '$5=="Approved,Issued" && ($2 ~ /d$/ || $2 ~ /h$/) {print $1}' | xargs -r kubectl delete 2>/dev/null || true

  # 2. Auto-approve all pending CSRs from spokes
  for csr in $(kubectl get csr --no-headers 2>/dev/null | awk '$5=="Pending" || /Pending/ {print $1}'); do
    [ -n "$csr" ] && kubectl certificate approve "$csr" 2>/dev/null || true
  done

  # 3. Auto-accept pending managed clusters
  for mc in $(kubectl get managedclusters -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' 2>/dev/null || true); do
    [ -z "$mc" ] && continue
    clusteradm accept --clusters "$mc" --skip-approve-check 2>/dev/null || true
    kubectl patch managedcluster "$mc" --type merge -p '{"spec":{"hubAcceptsClient":true}}' 2>/dev/null || true
  done
else
  # THIS hub is in STANDBY mode (PrimaryHub is UP and this is SecondaryHub)
  # Keep managed clusters in standby state (.spec.hubAcceptsClient = false) to prevent split-brain
  for mc in $(kubectl get managedclusters -o jsonpath='{range .items[?(@.spec.hubAcceptsClient==true)]}{.metadata.name}{"\n"}{end}' 2>/dev/null || true); do
    [ -n "$mc" ] && kubectl patch managedcluster "$mc" --type merge -p '{"spec":{"hubAcceptsClient":false}}' 2>/dev/null || true
  done
fi

# 4. Synchronize active clusters from primary hub to standby hubs (when Primary is active)
if [ "$ROLE" = "hub" ] && [ "$HUB_PRIORITY" = "1" ]; then
  standby_hubs=$(aws ssm get-parameters-by-path --path "/sandbox/clusters" --region "us-east-1" --query "Parameters[*].Value" --output json 2>/dev/null || echo "[]")
  standby_ips=$(echo "$standby_hubs" | jq -r '[.[] | (if type=="string" then fromjson else . end) | select(.role=="hub" and .priority!="1")] | .[].wg_ip' 2>/dev/null || true)
  [ -z "$standby_ips" ] && standby_ips="10.99.0.2"

  for mc in $(kubectl get managedclusters -o jsonpath='{.items[?(@.status.conditions[?(@.type=="HubAcceptedManagedCluster")].status=="True")].metadata.name}' 2>/dev/null || true); do
    [ -z "$mc" ] && continue
    for standby_wg in $standby_ips; do
      if curl -sk -m 2 "https://$${standby_wg}:6443/livez" >/dev/null 2>&1; then
        SEC_TOKEN=$(aws ssm get-parameter --name "/sandbox/ocm/tokens/secondaryhub" --with-decryption --region "us-east-1" --query "Parameter.Value" --output text 2>/dev/null || true)
        AUTH_FLAG=""
        [ -n "$SEC_TOKEN" ] && [ "$SEC_TOKEN" != "None" ] && AUTH_FLAG="--token=$SEC_TOKEN"
        if ! kubectl --kubeconfig=/etc/kubernetes/admin.conf --server="https://$${standby_wg}:6443" $AUTH_FLAG --insecure-skip-tls-verify get managedcluster "$mc" >/dev/null 2>&1; then
          echo "Replicating spoke $mc to standby hub $standby_wg..."
          kubectl get namespace "$mc" -o yaml 2>/dev/null | kubectl --kubeconfig=/etc/kubernetes/admin.conf --server="https://$${standby_wg}:6443" $AUTH_FLAG --insecure-skip-tls-verify apply -f - 2>/dev/null || true
          kubectl get clusterrole "open-cluster-management:managedcluster:$mc" -o yaml 2>/dev/null | kubectl --kubeconfig=/etc/kubernetes/admin.conf --server="https://$${standby_wg}:6443" $AUTH_FLAG --insecure-skip-tls-verify apply -f - 2>/dev/null || true
          kubectl get clusterrolebinding "open-cluster-management:managedcluster:$mc" -o yaml 2>/dev/null | kubectl --kubeconfig=/etc/kubernetes/admin.conf --server="https://$${standby_wg}:6443" $AUTH_FLAG --insecure-skip-tls-verify apply -f - 2>/dev/null || true
          kubectl get managedcluster "$mc" -o json 2>/dev/null | jq 'del(.metadata.uid, .metadata.resourceVersion, .metadata.creationTimestamp, .metadata.ownerReferences, .metadata.managedFields, .metadata.annotations, .metadata.finalizers, .status) | .spec.hubAcceptsClient = false' | kubectl --kubeconfig=/etc/kubernetes/admin.conf --server="https://$${standby_wg}:6443" $AUTH_FLAG --insecure-skip-tls-verify apply -f - 2>/dev/null || true
          NOW=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
          kubectl --kubeconfig=/etc/kubernetes/admin.conf --server="https://$${standby_wg}:6443" $AUTH_FLAG --insecure-skip-tls-verify patch managedcluster "$mc" --subresource=status --type=merge -p "{\"status\":{\"conditions\":[{\"lastTransitionTime\":\"$NOW\",\"message\":\"Denied by hub cluster admin\",\"reason\":\"HubClusterAdminDenied\",\"status\":\"False\",\"type\":\"HubAcceptedManagedCluster\"},{\"lastTransitionTime\":\"$NOW\",\"message\":\"Managed cluster joined\",\"reason\":\"ManagedClusterJoined\",\"status\":\"True\",\"type\":\"ManagedClusterJoined\"},{\"lastTransitionTime\":\"$NOW\",\"message\":\"Released by SecondaryHub on standby\",\"reason\":\"ManagedClusterLeaseUpdateStopped\",\"status\":\"Unknown\",\"type\":\"ManagedClusterConditionAvailable\"}]}}" 2>/dev/null || true
        fi
      fi
    done
  done
fi

# 5. Autonomous Spoke Deregistration / Garbage Collection (Reaper on ALL hubs)
# Safe reaper: Only reap clusters that are completely absent from SSM /sandbox/clusters (permanently destroyed by Terraform)
for mc in $(kubectl get managedclusters -o jsonpath='{.items[*].metadata.name}' 2>/dev/null || true); do
  [ -z "$mc" ] && continue
  if aws ssm get-parameter --name "/sandbox/clusters/$mc" --region "us-east-1" >/dev/null 2>&1; then
    continue # Cluster is still in infrastructure registry, may be rebooting or replacing
  fi

  echo "Spoke cluster $mc is decommissioned from infrastructure. Initiating safe deregistration on $(hostname)..."
  kubectl patch managedcluster "$mc" -p '{"metadata":{"finalizers":[]}}' --type=merge 2>/dev/null || true
  kubectl delete managedcluster "$mc" --ignore-not-found=true 2>/dev/null || true
  kubectl get rolebinding -n "$mc" -o name 2>/dev/null | xargs -r -n 1 kubectl patch -n "$mc" -p '{"metadata":{"finalizers":[]}}' --type=merge 2>/dev/null || true
  kubectl patch ns "$mc" -p '{"spec":{"finalizers":[]}}' --type=merge 2>/dev/null || true
  timeout 10s kubectl delete ns "$mc" --ignore-not-found=true 2>/dev/null || true
  kubectl delete clusterrole "open-cluster-management:managedcluster:$mc" --ignore-not-found=true 2>/dev/null || true
  kubectl delete clusterrolebinding "open-cluster-management:managedcluster:$mc" --ignore-not-found=true 2>/dev/null || true
  kubectl get csr -o name 2>/dev/null | grep "$mc" | xargs -r kubectl delete 2>/dev/null || true
done
EOF_ACC
  chmod +x /usr/local/bin/ocm-auto-accept.sh
  cat << "EOF_ASVC" > /etc/systemd/system/ocm-auto-accept.service
[Unit]
Description=OCM Auto-Acceptor
[Service]
Type=oneshot
ExecStart=/usr/local/bin/ocm-auto-accept.sh
EOF_ASVC
  cat << "EOF_ATMR" > /etc/systemd/system/ocm-auto-accept.timer
[Unit]
Description=Run OCM Auto-Acceptor
[Timer]
OnBootSec=15s
OnUnitActiveSec=15s
[Install]
WantedBy=timers.target
EOF_ATMR
  systemctl daemon-reload
  systemctl enable --now ocm-auto-accept.timer 2>/dev/null || true
fi

# -----------------------------------------------------------------------------
# 7. Spoke Autonomous Multi-Hub Active/Standby Failover Daemon
# -----------------------------------------------------------------------------
if [ "$ROLE" = "spoke" ]; then
  cat << "EOF_RSYNC" > /usr/local/bin/sync-cluster-registry.sh
#!/usr/bin/env bash
set -euo pipefail
export KUBECONFIG=/etc/kubernetes/admin.conf
[ -f "$KUBECONFIG" ] || exit 0

SELF_NAME="${cluster_name}"

ca_b64=$(aws ssm get-parameter --name "/sandbox/pki/ca.crt" --region "us-east-1" --query "Parameter.Value" --output text 2>/dev/null | base64 -w0 || true)
prim_ca_b64=$(aws ssm get-parameter --name "/sandbox/ocm/hubs/primaryhub/ca.crt" --region "us-east-1" --query "Parameter.Value" --output text 2>/dev/null | base64 -w0 || true)
[ -z "$prim_ca_b64" ] && prim_ca_b64="$ca_b64"
sec_ca_b64=$(aws ssm get-parameter --name "/sandbox/ocm/hubs/secondaryhub/ca.crt" --region "us-east-1" --query "Parameter.Value" --output text 2>/dev/null | base64 -w0 || true)
[ -z "$sec_ca_b64" ] && sec_ca_b64="$ca_b64"

prim_token=$(aws ssm get-parameter --name "/sandbox/ocm/tokens/primaryhub" --region "us-east-1" --query "Parameter.Value" --with-decryption --output text 2>/dev/null || \
             aws ssm get-parameter --name "/sandbox/ocm/bootstrap-token" --region "us-east-1" --query "Parameter.Value" --output text 2>/dev/null || true)
sec_token=$(aws ssm get-parameter --name "/sandbox/ocm/tokens/secondaryhub" --region "us-east-1" --query "Parameter.Value" --with-decryption --output text 2>/dev/null || true)

kubectl create namespace open-cluster-management-agent 2>/dev/null || true

# Pre-stage both hub bootstrap secrets
if [ -n "$prim_ca_b64" ] && [ -n "$prim_token" ] && [ "$prim_token" != "None" ]; then
  cat <<EOF_PSEC | kubectl -n open-cluster-management-agent apply -f - 2>/dev/null || true
apiVersion: v1
kind: Secret
metadata:
  name: primaryhub-kubeconfig
  namespace: open-cluster-management-agent
type: Opaque
stringData:
  kubeconfig: |
    apiVersion: v1
    kind: Config
    clusters:
    - name: hub
      cluster:
        server: https://10.99.0.1:6443
        certificate-authority-data: $${prim_ca_b64}
    contexts:
    - name: bootstrap
      context:
        cluster: hub
        user: bootstrap
    current-context: bootstrap
    users:
    - name: bootstrap
      user:
        token: $${prim_token}
EOF_PSEC
fi

if [ -n "$sec_ca_b64" ] && [ -n "$sec_token" ] && [ "$sec_token" != "None" ]; then
  cat <<EOF_SSEC | kubectl -n open-cluster-management-agent apply -f - 2>/dev/null || true
apiVersion: v1
kind: Secret
metadata:
  name: secondaryhub-kubeconfig
  namespace: open-cluster-management-agent
type: Opaque
stringData:
  kubeconfig: |
    apiVersion: v1
    kind: Config
    clusters:
    - name: hub
      cluster:
        server: https://10.99.0.2:6443
        certificate-authority-data: $${sec_ca_b64}
    contexts:
    - name: bootstrap
      context:
        cluster: hub
        user: bootstrap
    current-context: bootstrap
    users:
    - name: bootstrap
      user:
        token: $${sec_token}
EOF_SSEC
fi

# Active Hub Determination: PrimaryHub (Priority 1) -> SecondaryHub (Standby/Failover)
TARGET_SERVER=""
TARGET_TOKEN=""
TARGET_CA=""
if curl -sk -m 2 "https://10.99.0.1:6443/livez" >/dev/null 2>&1; then
  TARGET_SERVER="https://10.99.0.1:6443"
  TARGET_TOKEN="$prim_token"
  TARGET_CA="$prim_ca_b64"
elif curl -sk -m 2 "https://10.99.0.2:6443/livez" >/dev/null 2>&1; then
  TARGET_SERVER="https://10.99.0.2:6443"
  TARGET_TOKEN="$sec_token"
  TARGET_CA="$sec_ca_b64"
fi

[ -z "$TARGET_SERVER" ] && exit 0

# If klusterlet is not yet initialized, autonomously bootstrap it
if ! kubectl get klusterlet klusterlet >/dev/null 2>&1; then
  if [ -n "$TARGET_TOKEN" ] && [ "$TARGET_TOKEN" != "None" ]; then
    clusteradm --kubeconfig=/etc/kubernetes/admin.conf join --hub-token "$TARGET_TOKEN" --hub-apiserver "$TARGET_SERVER" --cluster-name "$SELF_NAME" --wait=false 2>&1 || true
  fi
  exit 0
fi

current_bootstrap=$(kubectl -n open-cluster-management-agent get secret bootstrap-hub-kubeconfig -o jsonpath='{.data.kubeconfig}' 2>/dev/null | base64 -d 2>/dev/null | awk '/server:/ {print $2}' || true)
current_active=$(kubectl -n open-cluster-management-agent get secret hub-kubeconfig-secret -o jsonpath='{.data.kubeconfig}' 2>/dev/null | base64 -d 2>/dev/null | awk '/server:/ {print $2}' || true)

if [ "$current_bootstrap" != "$TARGET_SERVER" ] || [ "$current_active" != "$TARGET_SERVER" ]; then
  echo "Switching active hub from $${current_active:-unknown} to $TARGET_SERVER..."
  cat <<EOF_ACT | kubectl apply -f -
apiVersion: v1
kind: Secret
metadata:
  name: bootstrap-hub-kubeconfig
  namespace: open-cluster-management-agent
type: Opaque
stringData:
  kubeconfig: |
    apiVersion: v1
    kind: Config
    clusters:
    - name: hub
      cluster:
        server: $TARGET_SERVER
        certificate-authority-data: $TARGET_CA
    contexts:
    - name: bootstrap
      context:
        cluster: hub
        user: bootstrap
    current-context: bootstrap
    users:
    - name: bootstrap
      user:
        token: $TARGET_TOKEN
EOF_ACT

  kubectl -n open-cluster-management-agent delete secret hub-kubeconfig-secret --ignore-not-found=true
  kubectl -n open-cluster-management-agent rollout restart deployment klusterlet-registration-agent 2>/dev/null || true
  kubectl -n open-cluster-management-agent rollout restart deployment klusterlet-work-agent 2>/dev/null || true
fi
EOF_RSYNC
  chmod +x /usr/local/bin/sync-cluster-registry.sh
  cat << "EOF_RSVC" > /etc/systemd/system/sync-cluster-registry.service
[Unit]
Description=Sync Hub Cluster Registry
[Service]
Type=oneshot
ExecStart=/usr/local/bin/sync-cluster-registry.sh
EOF_RSVC
  cat << "EOF_RTMR" > /etc/systemd/system/sync-cluster-registry.timer
[Unit]
Description=Periodic Hub Cluster Registry Sync
[Timer]
OnBootSec=20s
OnUnitActiveSec=30s
[Install]
WantedBy=timers.target
EOF_RTMR
  systemctl daemon-reload
  systemctl enable --now sync-cluster-registry.timer 2>/dev/null || true
  /usr/local/bin/sync-cluster-registry.sh 2>/dev/null || true
fi

%{ if enable_password_auth ~}
PW=$(aws secretsmanager get-secret-value --secret-id "${secret_id}" --region "${region}" --query SecretString --output text)
echo "${ssh_username}:$PW" | chpasswd
install -d -m 0755 /etc/ssh/sshd_config.d
printf "PasswordAuthentication yes\nKbdInteractiveAuthentication no\n" > /etc/ssh/sshd_config.d/60-password-auth.conf
systemctl restart sshd
unset PW
%{ endif ~}

echo "=== Autonomous Bootstrap Complete at $(date) ==="
