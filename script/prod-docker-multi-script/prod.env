# ==============================================================================
# prod-docker-multi-script / prod.env
# Multi-Region Multi-Cluster Production Configuration (AWS SSM Session Manager)
# ==============================================================================
# Public IPs are disabled; instances run in private subnets and connect via AWS SSM.

# ── Connection Mode ───────────────────────────────────────────────────────────
USE_SSM="true"

# ── AWS Regions per Cluster ───────────────────────────────────────────────────
PRIMARYHUB_REGION="us-east-1"
SECONDARYHUB_REGION="eu-west-1"
SPOKE1_REGION="eu-central-1"
SPOKE2_REGION="ap-south-1"
CORTEX_REGION="us-east-1"

# ── EC2 Target Instance IDs (Private instances reached via AWS SSM) ───────────
PRIMARYHUB_TARGET="i-00715ae98fb1d95e4"
PRIMARYHUB_HOST="i-00715ae98fb1d95e4"

SECONDARYHUB_TARGET="i-0178f6080f0b209ab"
SECONDARYHUB_HOST="i-0178f6080f0b209ab"

SPOKE1_TARGET="i-062988966483cf58b"
SPOKE1_HOST="i-062988966483cf58b"

SPOKE2_TARGET="i-0b9e4ace4051adcb4"
SPOKE2_HOST="i-0b9e4ace4051adcb4"

CORTEX_TARGET="i-0c348d20cb3cb9996"
CORTEX_HOST="i-0c348d20cb3cb9996"

# ── Private IPv4 Addresses (for WireGuard mesh over Inter-Region VPC Peering) ──
PRIMARYHUB_PRIVATE_IP="10.20.137.202"
SECONDARYHUB_PRIVATE_IP="10.22.137.213"
SPOKE1_PRIVATE_IP="10.23.128.66"
SPOKE2_PRIVATE_IP="10.21.140.63"
CORTEX_PRIVATE_IP="10.20.147.62"

# ── Remote User & Fleet Key Configuration ─────────────────────────────────────
REMOTE_USER="ec2-user"
SSH_USER="ec2-user"
SSH_KEY_PATH="~/.ssh/bb-sandbox-fleet"
SSH_PORT="22"

# ── WireGuard Overlay Configuration ───────────────────────────────────────────
WG_PORT="51820"
