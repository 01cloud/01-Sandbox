# ==============================================================================
# prod-docker-multi-script / prod.env.example
# Multi-Region Multi-Cluster Production Configuration (AWS SSM Session Manager)
# ==============================================================================
# Public IPs are disabled; instances run in private subnets and connect via AWS SSM.

# ── Connection Mode ───────────────────────────────────────────────────────────
USE_SSM="true"

# ── AWS Regions per Cluster ───────────────────────────────────────────────────
PRIMARYHUB_REGION="us-east-1"
SECONDARYHUB_REGION="eu-west-1"
SPOKE1_REGION="eu-central-1"
SPOKE2_REGION="ap-south-1"

# ── EC2 Target Instance IDs (Private instances reached via AWS SSM) ───────────
PRIMARYHUB_TARGET="i-09af7401f1fbdef5d"
PRIMARYHUB_HOST="i-09af7401f1fbdef5d"

SECONDARYHUB_TARGET="i-032e4ce10ad3fc0e4"
SECONDARYHUB_HOST="i-032e4ce10ad3fc0e4"

SPOKE1_TARGET="i-0bf2295faaa3df241"
SPOKE1_HOST="i-0bf2295faaa3df241"

SPOKE2_TARGET="i-0538cf957f5948893"
SPOKE2_HOST="i-0538cf957f5948893"

# ── Private IPv4 Addresses (for WireGuard mesh over Inter-Region VPC Peering) ──
# Leave blank to automatically discover via AWS EC2 API or SSM at runtime,
# or explicitly set to override.
PRIMARYHUB_PRIVATE_IP=""
SECONDARYHUB_PRIVATE_IP=""
SPOKE1_PRIVATE_IP=""
SPOKE2_PRIVATE_IP=""

# ── Remote User & Fleet Key Configuration ─────────────────────────────────────
REMOTE_USER="ec2-user"
SSH_USER="ec2-user"
SSH_KEY_PATH="~/.ssh/bb-sandbox-fleet"
SSH_PORT="22"

# ── WireGuard Overlay Configuration ───────────────────────────────────────────
WG_PORT="51820"
