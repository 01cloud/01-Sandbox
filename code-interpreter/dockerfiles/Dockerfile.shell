FROM alpine:3.22

ENV LANG=C.UTF-8

# Install shellcheck and core dependencies
RUN apk add --no-cache \
    ca-certificates \
    curl \
    git \
    python3 \
    py3-pip \
    bash \
    shellcheck \
    && rm -rf /var/cache/apk/*

# Install semgrep for Shell/Bash SAST scanning
RUN pip3 install --break-system-packages --no-cache-dir semgrep \
    && find /usr/lib/python* -name '__pycache__' -exec rm -rf {} + 2>/dev/null || true \
    && find /usr/lib/python* -name '*.pyc' -delete \
    && rm -rf /root/.cache /var/cache/apk/*

# Install gitleaks and trivy
RUN set -eux; \
    curl -fsSL --retry 5 https://github.com/gitleaks/gitleaks/releases/download/v8.18.4/gitleaks_8.18.4_linux_x64.tar.gz -o /tmp/gitleaks.tar.gz; \
    tar -xzf /tmp/gitleaks.tar.gz -C /usr/local/bin gitleaks; \
    curl -fsSL --retry 5 https://github.com/aquasecurity/trivy/releases/download/v0.69.3/trivy_0.69.3_Linux-64bit.tar.gz -o /tmp/trivy.tar.gz; \
    tar -xzf /tmp/trivy.tar.gz -C /usr/local/bin trivy; \
    chmod 755 /usr/local/bin/gitleaks /usr/local/bin/trivy /usr/bin/shellcheck; \
    rm -rf /tmp/*

RUN mkdir -p /opt/opensandbox/src /opt/opensandbox/rules /workspace /reports

COPY src/ /opt/opensandbox/src/
COPY rules/ /opt/opensandbox/rules/
COPY scripts/code-interpreter.sh /opt/opensandbox/code-interpreter.sh
RUN chmod +x /opt/opensandbox/code-interpreter.sh

WORKDIR /workspace
ENTRYPOINT ["/opt/opensandbox/code-interpreter.sh"]
