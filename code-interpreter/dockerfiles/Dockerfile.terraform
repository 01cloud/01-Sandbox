# ---------- Stage 1: grab pre-built binaries from official images ----------
FROM hashicorp/terraform:1.10.5 AS terraform
FROM ghcr.io/terraform-linters/tflint:v0.55.0 AS tflint
FROM aquasec/tfsec:v1.28.13 AS tfsec
FROM zricethezav/gitleaks:v8.18.4 AS gitleaks
FROM aquasec/trivy:0.69.3 AS trivy

# ---------- Stage 2: final minimal image ----------
FROM alpine:3.22

ENV LANG=C.UTF-8

RUN apk add --no-cache ca-certificates curl bash python3 py3-pip

# Copy pre-built tool binaries (no download/retry logic needed)
COPY --from=terraform /bin/terraform /usr/local/bin/terraform
COPY --from=tflint /usr/local/bin/tflint /usr/local/bin/tflint
COPY --from=tfsec /usr/bin/tfsec /usr/local/bin/tfsec
COPY --from=gitleaks /usr/bin/gitleaks /usr/local/bin/gitleaks
COPY --from=trivy /usr/local/bin/trivy /usr/local/bin/trivy

RUN chmod 755 /usr/local/bin/terraform /usr/local/bin/tflint \
    /usr/local/bin/tfsec /usr/local/bin/gitleaks /usr/local/bin/trivy

# Checkov (Python-based)
RUN pip3 install --break-system-packages --no-cache-dir checkov

RUN mkdir -p /opt/opensandbox/src /opt/opensandbox/rules /workspace /reports

COPY src/ /opt/opensandbox/src/
COPY rules/ /opt/opensandbox/rules/
COPY scripts/code-interpreter.sh /opt/opensandbox/code-interpreter.sh
RUN chmod +x /opt/opensandbox/code-interpreter.sh

WORKDIR /workspace
ENTRYPOINT ["/opt/opensandbox/code-interpreter.sh"]
