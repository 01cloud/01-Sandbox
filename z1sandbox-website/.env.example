# Authentication (Auth0)
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://code-inspector-api

# Backend Base API URL
# In non-prod VMs: http://<GATEWAY_OR_HUB_IP>
# In production: https://api.yourdomain.com
# Same-origin deployment: leave blank or omit to use same-origin relative proxying
VITE_API_BASE_URL=http://192.168.100.10

# Optional: Override registered backends JSON (can use relative paths or absolute URLs)
# VITE_DASHBOARD_BACKENDS_JSON='[{"id":"Z1_SANDBOX","name":"01 Sandbox","description":"Production-grade hardened cluster for secure code execution.","icon":"terminal","color":"indigo","baseUrl":"/api/v1/01sbx","documentationUrl":"/api/v1/01sbx/docs"}]'

# Developer mode flag
VITE_ENABLE_DEV_MODE=false
