# ==============================================================================
# prod-docker-multi-script / prod.env
# Multi-Region Multi-Cluster Production Configuration (AWS SSM Session Manager)
# ==============================================================================
# Public IPs are disabled; instances run in private subnets and connect via AWS SSM.

# ── Connection Mode ───────────────────────────────────────────────────────────
USE_SSM="true"

# ── AWS Regions per Cluster ───────────────────────────────────────────────────
PRIMARYHUB_REGION="us-east-1"
SECONDARYHUB_REGION="eu-west-1"
SPOKE1_REGION="eu-central-1"
SPOKE2_REGION="ap-south-1"
CORTEX_REGION="us-east-1"

# ── EC2 Target Instance IDs (Private instances reached 10.20.130.108"
PRIMARYHUB_HOST="i-0bcd35beefd16e3e3"

SECONDARYHUB_TARGET="i-04dde79b57a1df0b5"
SECONDARYHUB_HOST="i-04dde79b57a1df0b5"

SPOKE1_TARGET="i-0bfedaa902fea2517"
SPOKE1_HOST="i-0bfedaa902fea2517"

SPOKE2_TARGET="i-08d8905ffe1b39a93"
SPOKE2_HOST="i-08d8905ffe1b39a93"

CORTEX_TARGET="i-00345c93f722ba2f6"
CORTEX_HOST="i-00345c93f722ba2f6"

# ── Private IPv4 Addresses (for WireGuard mesh over Inter-Region VPC Peering) ──
PRIMARYHUB_PRIVATE_IP="10.20.130.108"
SECONDARYHUB_PRIVATE_IP="10.22.138.156"
SPOKE1_PRIVATE_IP="10.23.141.226"
SPOKE2_PRIVATE_IP="10.21.138.35"
CORTEX_PRIVATE_IP="10.20.144.171"

# ── Remote User & Fleet Key Configuration ─────────────────────────────────────
REMOTE_USER="ec2-user"
SSH_USER="ec2-user"
SSH_KEY_PATH="~/.ssh/bb-sandbox-fleet"
SSH_PORT="22"

# ── WireGuard Overlay Configuration ───────────────────────────────────────────
WG_PORT="51820"
