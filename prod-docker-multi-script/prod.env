# ==============================================================================
# prod-docker-multi-script / prod.env
# Multi-Region Multi-Cluster Production Configuration (AWS SSM Session Manager)
# ==============================================================================
# Public IPs are disabled; instances run in private subnets and connect via AWS SSM.

# ── Connection Mode ───────────────────────────────────────────────────────────
USE_SSM="true"

# ── AWS Regions per Cluster ───────────────────────────────────────────────────
PRIMARYHUB_REGION="us-east-1"
SECONDARYHUB_REGION="eu-west-1"
SPOKE1_REGION="eu-central-1"
SPOKE2_REGION="ap-south-1"

# ── EC2 Target Instance IDs (Private instances reached via AWS SSM) ───────────
PRIMARYHUB_TARGET="i-064822cba5ff537bb"
PRIMARYHUB_HOST="i-064822cba5ff537bb"

SECONDARYHUB_TARGET="i-0332216f039cbfc09"
SECONDARYHUB_HOST="i-0332216f039cbfc09"

SPOKE1_TARGET="i-074e3788a60115cec"
SPOKE1_HOST="i-074e3788a60115cec"

SPOKE2_TARGET="i-08b08508c9c1cff32"
SPOKE2_HOST="i-08b08508c9c1cff32"

# ── Private IPv4 Addresses (for WireGuard mesh over Inter-Region VPC Peering) ──
PRIMARYHUB_PRIVATE_IP="10.20.132.154"
SECONDARYHUB_PRIVATE_IP="10.22.139.4"
SPOKE1_PRIVATE_IP="10.23.128.119"
SPOKE2_PRIVATE_IP="10.21.131.127"

# ── Remote User & Fleet Key Configuration ─────────────────────────────────────
REMOTE_USER="ec2-user"
SSH_USER="ec2-user"
SSH_KEY_PATH="~/.ssh/bb-sandbox-fleet"
SSH_PORT="22"

# ── WireGuard Overlay Configuration ───────────────────────────────────────────
WG_PORT="51820"
