# ==============================================================================
# prod-docker-multi-script / prod.env.example
# Multi-Region Multi-Cluster Production Configuration
# ==============================================================================
# Copy this file to prod.env and fill in the Public/Elastic IPs of your 4 EC2 instances.
# Alternatively, run 'terraform apply' in the terraform/ directory to generate this file.

# ── EC2 Node Hostnames or Public IPs ──────────────────────────────────────────
# PrimaryHub + Envoy Gateway (Region A, e.g., us-east-1)
PRIMARYHUB_HOST="52.213.158.85"

# SecondaryHub Backup (Region B, e.g., eu-west-1)
SECONDARYHUB_HOST="13.234.240.239"

# Spoke1 Workloads with Kata Firecracker (Region C, e.g., ap-southeast-1)
SPOKE1_HOST="18.197.200.4"

# Spoke2 Workloads with Kata Firecracker (Region D, e.g., us-west-2)
SPOKE2_HOST="34.235.149.38"

# ── SSH Authentication ────────────────────────────────────────────────────────
# Default SSH username across EC2 instances (default for Ubuntu AMIs is 'ubuntu')
SSH_USER="ec2-user"

# Default private SSH key used if per-instance keys are not specified below
SSH_KEY_PATH="~/.ssh/kamalaws.pem"

# SSH Port (default: 22)
SSH_PORT="22"

# ── Optional: Per-Instance Keypair Overrides ──────────────────────────────────
# If your 4 EC2 instances are in different regions and use separate keypairs,
# uncomment and set their respective .pem / private key paths:
# PRIMARYHUB_SSH_KEY="~/.ssh/kamalaws.pem"
# PRIMARYHUB_SSH_USER="ubuntu"
# SECONDARYHUB_SSH_KEY="~/.ssh/kamalaws.pem"
# SECONDARYHUB_SSH_USER="ubuntu"
# SPOKE1_SSH_KEY="~/.ssh/kamalaws.pem"
# SPOKE1_SSH_USER="ubuntu"
# SPOKE2_SSH_KEY="~/.ssh/kamalaws.pem"
# SPOKE2_SSH_USER="ec2-user"

# ── WireGuard Overlay Configuration ───────────────────────────────────────────
# Inbound UDP port for WireGuard (must be open in EC2 Security Groups)
WG_PORT="51820"
